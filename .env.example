# Claude credentials. Set ONE of the two below.
# If both are set the API key wins, matching the SDK's own precedence.

# 1. API key — what production uses.
#    Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 2. OAuth access token — for local development only.
#    Mint one with:  ant auth print-credentials --access-token
#    Sent as `Authorization: Bearer`, with the oauth-2025-04-20 beta flag.
#    Short-lived, so expect to refresh it. docs/01-product.md settled that a
#    personal Claude subscription can't serve other users, so this is a dev
#    convenience, not a deployment option.
# ANTHROPIC_AUTH_TOKEN=

# Optional. Defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-5

# Ports. Both default to these same numbers when unset, so `npm run dev` and
# `npm run docsvc` behave identically whether or not you set them here. A real
# environment variable still wins over the file.
# FRONTEND_PORT=3001
# BACKEND_PORT=8001

# docsvc — the file pipeline (services/docsvc).
# Leave this unset locally: BACKEND_PORT above already decides the URL. Set it
# to reach a docsvc that is not on localhost, and it overrides BACKEND_PORT.
# DOCSVC_URL=https://docsvc.example.fly.dev

# docsvc refuses to serve without a token: every route but /health answers 503,
# so a forgotten variable can never be the difference between locked and open.
# Set this to any random string locally — both sides read it from here, the
# launcher through scripts/ports.mjs and the web app through Next.js.
DOCSVC_TOKEN=

# The deliberate escape hatch, for when you want docsvc open locally without
# minting a token. Only the exact word `true` opens it, and a real DOCSVC_TOKEN
# always wins over it. Never set this in production.
# DOCSVC_ALLOW_INSECURE=true
